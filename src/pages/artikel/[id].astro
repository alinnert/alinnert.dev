---
import { render } from 'astro:content'
import BadgeList from '../../components/BadgeList.astro'
import OneColumnLayout from '../../layouts/OneColumnLayout.astro'
import { getStaticPathsFromCollection } from '../../lib/astro/staticPathsFromCollection'
import Article from '../../components/Article.astro'

export const getStaticPaths = getStaticPathsFromCollection('artikel')

const { item: article } = Astro.props
const { Content } = await render(article)
---

<OneColumnLayout>
  <Article title={article.data.title}>
    <Fragment slot="header">
      <div class="date">
        {
          article.data.published.toLocaleString('de-DE', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
        }
      </div>
      <BadgeList items={article.data.topics} urlPrefix="/artikel/thema" />
    </Fragment>

    <Content />
  </Article>
</OneColumnLayout>

<style>
  .date {
    font-weight: var(--font-weight-medium);
    color: var(--palette-neutral-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--spacing-2);
  }
</style>
