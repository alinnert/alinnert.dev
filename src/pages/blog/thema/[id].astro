---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import Card from '../../../components/Card.astro'
import ContentGrid from '../../../components/ContentGrid.astro'
import TwoColumnsLayout from '../../../layouts/TwoColumnsLayout.astro'
import ArticleTopicsList from '../../../widgets/ArticleTopicsList.astro'
import ArticlesList from '../../../widgets/ArticlesList.astro'

const articles = await getCollection('blog')

export const getStaticPaths = (async () => {
  const articles = await getCollection('blog')
  const topics = Array.from(
    new Set(articles.flatMap((a) => a.data.topics ?? [])),
  )
  return topics.map((topic) => ({
    params: { id: topic.toLowerCase() },
    props: { tag: topic },
  }))
}) satisfies GetStaticPaths

const { tag: topic } = Astro.props

const articlesWithTag = articles.filter((a) =>
  (a.data.topics ?? []).includes(topic),
)
---

<TwoColumnsLayout title={`Beiträge zum Thema "${topic}"`}>
  <Fragment slot="sidebar">
    <ArticleTopicsList />
  </Fragment>

  <ContentGrid columns={2}>
    <ArticlesList topic={topic} />
  </ContentGrid>
</TwoColumnsLayout>
