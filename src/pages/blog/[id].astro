---
import { render } from 'astro:content'
import BadgeList from '../../components/BadgeList.astro'
import OneColumnLayout from '../../layouts/OneColumnLayout.astro'
import { getStaticPathsFromCollection } from '../../lib/astro/staticPathsFromCollection'

export const getStaticPaths = getStaticPathsFromCollection('blog')

const { item: article } = Astro.props
const { Content } = await render(article)
---

<OneColumnLayout title={article.data.title}>
  <BadgeList items={article.data.topics} urlPrefix="/blog/thema" />

  <article>
    <Content />
  </article>
</OneColumnLayout>

<style>
  article {
    margin-top: var(--spacing-16);
  }
</style>
