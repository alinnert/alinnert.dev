---
import { getCollection } from 'astro:content'
import ArticleLink from '../../components/ArticleLink.astro'
import BlockList from '../../components/BlockList.astro'
import TwoColumnsLayout from '../../layouts/TwoColumnsLayout.astro'

const articles = await getCollection('blog')
---

<TwoColumnsLayout title="Blog">
  <Fragment slot="sidebar"> Sidebar </Fragment>

  <p>
    Lorem ipsum dolor, sit amet consectetur adipisicing elit. Optio alias
    aliquam, officiis consectetur magnam magni sint odio temporibus aut? Quae
    dolores architecto maxime quaerat obcaecati blanditiis sequi corrupti
    incidunt animi!
  </p>

  <BlockList>
    {
      articles.map((article) => (
        <ArticleLink
          title={article.data.title}
          url={`/blog/${article.id}`}
          published={article.data.published}
          tags={article.data.tags}
        />
      ))
    }
  </BlockList>
</TwoColumnsLayout>
