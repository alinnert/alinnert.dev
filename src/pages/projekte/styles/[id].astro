---
import ContentGrid from '../../../components/ContentGrid.astro';
import TwoColumnsLayout from '../../../layouts/TwoColumnsLayout.astro';
import { getStaticPathsFromProp } from '../../../lib/astro/staticPathsFromCollection'

export const getStaticPaths = getStaticPathsFromProp('projects', 'styles')

const { propItem: framework } = Astro.props
---

<TwoColumnsLayout title={`Projekte auf Basis von ${framework}`}>
  <Fragment slot="sidebar">
    Sidebar...
  </Fragment>

  <ContentGrid columns={2}>
    Projekte...
  </ContentGrid>
</TwoColumnsLayout>