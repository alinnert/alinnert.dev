---
import { getCollection } from 'astro:content'
import ContentGrid from '../../components/ContentGrid.astro'
import ProjectLink from '../../components/ProjectLink.astro'
import TwoColumnsLayout from '../../layouts/TwoColumnsLayout.astro'
import ContentFilter from '../../widgets/ContentFilter.astro'

const projects = await getCollection('projekte')
---

<TwoColumnsLayout title="Alle Projekte">
  <Fragment slot="sidebar">
    <ContentFilter
      title="Sprachen"
      baseUrl="/projekte/sprache"
      collection={projects}
      filterProp="languages"
    />
    <ContentFilter
      title="Frameworks"
      baseUrl="/projekte/framework"
      collection={projects}
      filterProp="frameworks"
    />
    <ContentFilter
      title="Libraries"
      baseUrl="/projekte/library"
      collection={projects}
      filterProp="libraries"
    />
    <ContentFilter
      title="Styles"
      baseUrl="/projekte/styles"
      collection={projects}
      filterProp="styles"
    />
  </Fragment>

  <ContentGrid columns={2}>
    {projects.map((project) => <ProjectLink project={project} />)}
  </ContentGrid>
</TwoColumnsLayout>
