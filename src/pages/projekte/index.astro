---
import { getCollection } from 'astro:content'
import BadgeList from '../../components/BadgeList.astro'
import Card from '../../components/Card.astro'
import ContentGrid from '../../components/ContentGrid.astro'
import TwoColumnsLayout from '../../layouts/TwoColumnsLayout.astro'
import IconProperty from '../../components/IconProperty.astro'

const projects = await getCollection('projects')
---

<TwoColumnsLayout title="Meine Projekte">
  <Fragment slot="sidebar"> Sidebar </Fragment>

  <ContentGrid columns={2}>
    {
      projects.map((project) => (
        <Card title={project.data.name} url={`/projekte/${project.id}`}>
          <Fragment slot="props">
            {(project.data.languages?.length ?? 0) > 0 ? (
              <IconProperty icon="ion:code-slash-outline" label="Sprache">
                <BadgeList
                  items={project.data.languages}
                  urlPrefix="/projekte/sprache"
                />
              </IconProperty>
            ) : null}

            {(project.data.frameworks?.length ?? 0) > 0 ? (
              <IconProperty icon="ion:cube-outline" label="Frameworks">
                <BadgeList
                  items={project.data.frameworks}
                  urlPrefix="/projekte/framework"
                />
              </IconProperty>
            ) : null}

            {(project.data.libraries?.length ?? 0) > 0 ? (
              <IconProperty icon="ion:grid-outline" label="Bibliotheken">
                <BadgeList
                  items={project.data.libraries}
                  urlPrefix="/projekte/library"
                />
              </IconProperty>
            ) : null}

            {(project.data.styles?.length ?? 0) > 0 ? (
              <IconProperty icon="ion:color-palette-outline" label="Styles">
                <BadgeList
                  items={project.data.styles}
                  urlPrefix="/projekte/styles"
                />
              </IconProperty>
            ) : null}
          </Fragment>
        </Card>
      ))
    }
  </ContentGrid>
</TwoColumnsLayout>
