---
import { render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getStaticPathsFromCollection } from '../../lib/astro/staticPathsFromCollection'

export const getStaticPaths = getStaticPathsFromCollection('projects')

const { item } = Astro.props
const { Content } = await render(item)
---

<BaseLayout>
  <h1>{item.data.name}</h1>

  <dl>
    <dt>Sprachen</dt>
    <dd>{item.data.languages.join(', ')}</dd>

    {
      item.data.styles !== undefined ? (
        <Fragment>
          <dt>Styles</dt>
          <dd>{item.data.styles?.join(', ')}</dd>
        </Fragment>
      ) : null
    }

    {
      item.data.frameworks !== undefined ? (
        <Fragment>
          <dt>Frameworks</dt>
          <dd>{item.data.frameworks?.join(', ')}</dd>
        </Fragment>
      ) : null
    }

    {
      item.data.libraries !== undefined ? (
        <Fragment>
          <dt>Bibliotheken</dt>
          <dd>{item.data.libraries?.join(', ')}</dd>
        </Fragment>
      ) : null
    }
  </dl>

  <Content />
</BaseLayout>
