---
import { render } from 'astro:content'
import BadgeList from '../../components/BadgeList.astro'
import IconProperty from '../../components/IconProperty.astro'
import IconPropertyList from '../../components/IconPropertyList.astro'
import OneColumnLayout from '../../layouts/OneColumnLayout.astro'
import { getStaticPathsFromCollection } from '../../lib/astro/staticPathsFromCollection'
import Article from '../../components/Article.astro'

export const getStaticPaths = getStaticPathsFromCollection('projekte')

const { item } = Astro.props
const { Content } = await render(item)
---

<OneColumnLayout>
  <Article title={item.data.name}>
    <Fragment slot="header">
      <IconPropertyList>
        {
          (item.data.languages?.length ?? 0) > 0 ? (
            <IconProperty icon="ion:code-slash-outline" label="Sprache">
              <BadgeList
                items={item.data.languages}
                urlPrefix="/projekte/sprache"
              />
            </IconProperty>
          ) : null
        }
        {
          (item.data.frameworks?.length ?? 0) > 0 ? (
            <IconProperty icon="ion:cube-outline" label="Frameworks">
              <BadgeList
                items={item.data.frameworks}
                urlPrefix="/projekte/framework"
              />
            </IconProperty>
          ) : null
        }
        {
          (item.data.libraries?.length ?? 0) > 0 ? (
            <IconProperty icon="ion:grid-outline" label="Bibliotheken">
              <BadgeList
                items={item.data.libraries}
                urlPrefix="/projekte/bibliothek"
              />
            </IconProperty>
          ) : null
        }
        {
          (item.data.styles?.length ?? 0) > 0 ? (
            <IconProperty icon="ion:color-palette-outline" label="Styles">
              <BadgeList
                items={item.data.styles}
                urlPrefix="/projekte/styles"
              />
            </IconProperty>
          ) : null
        }
        {
          (item.data.repository?.length ?? 0) > 0 ? (
            <IconProperty icon="ion:git-branch-outline" label="Repository">
              <a href={item.data.repository}>{item.data.repository}</a>
            </IconProperty>
          ) : null
        }
        {
          (item.data.website?.length ?? 0) > 0 ? (
            <IconProperty icon="ion:link-outline" label="Webseite">
              <a href={item.data.website}>{item.data.website}</a>
            </IconProperty>
          ) : null
        }
      </IconPropertyList>
    </Fragment>

    <Content />
  </Article>
</OneColumnLayout>
