---
import { getCollection } from 'astro:content'
import BadgeList from '../components/BadgeList.astro'
import Card from '../components/Card.astro'

type Props = { topic?: string }

const { topic } = Astro.props

const articles = await getCollection('artikel')

const filteredArticles =
  topic !== undefined
    ? articles.filter((a) => a.data.topics?.includes(topic))
    : articles
---

{
  filteredArticles
    .toSorted((a, b) => (a.data.published < b.data.published ? 1 : -1))
    .map((article) => (
      <Card title={article.data.title} url={`/artikel/${article.id}`}>
        <Fragment slot="details">
          <div>
            {article.data.published.toLocaleString('de-DE', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })}
          </div>
          <div>
            <BadgeList items={article.data.topics} urlPrefix="/artikel/thema" />
          </div>
        </Fragment>
      </Card>
    ))
}
