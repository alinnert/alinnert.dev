---
function urlIs(pattern: string): boolean {
  return Astro.url.pathname === pattern
}

function urlStartsWith(pattern: string): boolean {
  return Astro.url.pathname.startsWith(pattern)
}
---

<header>
  <nav>
    <ul>
      <li>
        <a
          href="/"
          class="homepage-link"
          class:list={{ 'is-current': urlIs('/') }}>alinnert.dev</a
        >
      </li>
      <li>
        <a
          href="/artikel"
          class:list={{ 'is-current': urlStartsWith('/artikel') }}>Artikel</a
        >
      </li>
      <li>
        <a
          href="/projekte"
          class:list={{ 'is-current': urlStartsWith('/projekte') }}>Projekte</a
        >
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    position: fixed;
    z-index: 10;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    padding-block: var(--spacing-4);
    padding-inline: var(--spacing-2);
    background-image: url('/images/header-bg.webp');
    background-position: center;
    background-size: cover;
    color: white;
  }

  nav {
    grid-column: 3;
  }

  ul {
    display: flex;
    gap: var(--spacing-1);
    list-style-type: none;
  }

  a {
    color: white;
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    display: inline flow-root;
    padding-inline: var(--spacing-3);
    padding-block: var(--spacing-1_5);
    user-select: none;
  }

  .homepage-link {
    font-weight: var(--font-weight-extrabold);
  }

  .is-current {
    background: var(--palette-neutral-bg-no-auto);
    color: var(--palette-neutral-text-no-auto);
    border-radius: var(--radius-md);
  }
</style>
