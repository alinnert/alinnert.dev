---
import { getCollection } from 'astro:content'
import ArticleLink from './ArticleLink.astro'

const articles = await getCollection('blog')
---

{
  articles
    .toSorted((a, b) => (a.data.published < b.data.published ? 1 : -1))
    .map((article) => (
      <ArticleLink
        title={article.data.title}
        url={`/blog/${article.id}`}
        published={article.data.published}
        topics={article.data.topics}
      />
    ))
}
