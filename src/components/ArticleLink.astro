---
import BadgeList from './BadgeList.astro'
import IconProperty from './IconProperty.astro'

type Props = { title: string; url: string; published: Date; topics?: string[] }

const { title, url, published, topics } = Astro.props
---

<article>
  <header>
    <h2><a href={url}>{title}</a></h2>
  </header>

  <div class="properties">
    <IconProperty icon="ion:calendar-outline">
      {
        published.toLocaleString('de-DE', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        })
      }
    </IconProperty>
    <IconProperty icon="ion:pricetag-outline">
      <BadgeList items={topics} urlPrefix="/blog/thema" />
    </IconProperty>
  </div>
</article>

<style lang="scss">
  @use '../stylesheets/mixins/card.scss' as *;

  article {
    @include card();
    display: grid;
    grid-template-rows: auto 1fr;
    align-items: start;
  }

  header {
    margin-bottom: var(--spacing-4);
  }

  .properties {
    display: grid;
    gap: var(--spacing-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--theme-page--text-color--muted);
  }

  h2 {
    margin: 0;
    font-size: var(--text-lg);

    a {
      color: var(--palette-neutral-text);
    }
  }
</style>
