---
import { Icon } from 'astro-icon/components'
import { tagColorFromName, tagIconFromName } from '../lib/tagColor'

type Props = { name: string; color?: string; urlPrefix?: string }

const { name, color, urlPrefix } = Astro.props

const tagColor = color !== undefined ? color : tagColorFromName(name)
const tagIcon = tagIconFromName(name)
---

{
  urlPrefix === undefined ? (
    <span class="label">
      {tagIcon !== null ? (
        <span>
          <Icon name={tagIcon} />
        </span>
      ) : null}
      <span>{name}</span>
    </span>
  ) : (
    <a href={`${urlPrefix}/${name.toLowerCase()}`}>
      <span class="label">
        {tagIcon !== null ? (
          <span>
            <Icon name={tagIcon} />
          </span>
        ) : null}
        <span>{name}</span>
      </span>
    </a>
  )
}

<style define:vars={{ 'tag-color': tagColor }}>
  .label {
    --gradient-base: var(--tag-color, var(--theme-palette-neutral-light-500));
    --gradient-target: oklch(
      from var(--gradient-base) calc(l * 0.8) calc(c * 1.2) calc(h - 5)
    );

    @media (prefers-color-scheme: dark) {
      --gradient-base: var(--tag-color, var(--theme-palette-neutral-dark-600));
    }

    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    padding-inline: var(--spacing-2);
    padding-block: var(--spacing-1);
    background: linear-gradient(
      110deg in oklch,
      var(--gradient-base),
      var(--gradient-target)
    );
    border-radius: var(--radius-md);
  }

  span:has(> svg) {
    line-height: 0;
  }
</style>
