---
import { Icon } from 'astro-icon/components'
import { join } from 'node:path'
import { tagColorFromName, tagIconFromName } from '../lib/tagData'

type Props = { name: string; color?: string; urlPrefix?: string }

const { name, color, urlPrefix } = Astro.props

const tagColor = color !== undefined ? color : tagColorFromName(name)
const tagIcon = tagIconFromName(name)
---

{
  urlPrefix === undefined ? (
    <span class="label">
      {tagIcon !== null ? (
        <span>
          <Icon name={tagIcon} />
        </span>
      ) : null}
      <span>{name}</span>
    </span>
  ) : (
    <a href={join(urlPrefix, name.toLowerCase())}>
      <span class="label">
        {tagIcon !== null ? (
          <span>
            <Icon name={tagIcon} />
          </span>
        ) : null}
        <span>{name}</span>
      </span>
    </a>
  )
}

<style define:vars={{ 'tag-color': tagColor }}>
  .label {
    --gradient-base-color: var(
      --tag-color,
      var(--theme-palette-neutral-light-500)
    );
    --gradient-light-color: oklch(
      from var(--gradient-base-color) calc(l * 1.1) c h
    );
    --gradient-dark-color: oklch(
      from color-mix(in srgb, var(--gradient-base-color), hsl(200 90 30) 30%)
        calc(l * 0.95) c h
    );
    --gradient: linear-gradient(
      to left in oklch,
      var(--gradient-light-color),
      var(--gradient-dark-color)
    );

    @media (prefers-color-scheme: dark) {
      --gradient-base-color: var(
        --tag-color,
        var(--theme-palette-neutral-dark-600)
      );
    }

    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    color: white;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    padding-inline: var(--spacing-2);
    padding-block: var(--spacing-1);
    background: var(--gradient);
    border-radius: var(--radius-md);
    user-select: none;
    box-shadow:
      0 0 0 1px light-dark(var(--gradient-dark-color), var(--gradient-light-color)) inset;
    text-shadow: 0 0 2px var(--gradient-dark-color);
  }

  span:has(> svg) {
    line-height: 0;
  }
</style>
