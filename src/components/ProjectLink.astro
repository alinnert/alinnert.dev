---
import Badge from './Badge.astro'

type Props = { id: string; name: string; languages?: string[] }

const { id, name, languages } = Astro.props
---

<article>
  <header>
    <a href={`/projekte/${id}`}>{name}</a>
  </header>

  {
    languages !== undefined ? (
      <ul class="tag-list">
        {languages.map((l) => (
          <li>
            <Badge name={l} />
          </li>
        ))}
      </ul>
    ) : null
  }
</article>

<style lang="scss">
  @use '../stylesheets/mixins/card.scss' as *;

  article {
    @include card();
  }

  header a {
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    font-weight: var(--font-weight-bold);
  }
</style>
