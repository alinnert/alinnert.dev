---
import type { CollectionEntry } from 'astro:content'
import BadgeList from './BadgeList.astro'
import Card from './Card.astro'
import IconProperty from './IconProperty.astro'

type Props = { project: CollectionEntry<'projekte'> }

const { project } = Astro.props
---

<Card title={project.data.name} url={`/projekte/${project.id}`}>
  <Fragment slot="props">
    {
      (project.data.languages?.length ?? 0) > 0 ? (
        <IconProperty icon="ion:code-slash-outline" label="Sprache">
          <BadgeList
            items={project.data.languages}
            urlPrefix="/projekte/sprache"
          />
        </IconProperty>
      ) : null
    }

    {
      (project.data.frameworks?.length ?? 0) > 0 ? (
        <IconProperty icon="ion:cube-outline" label="Frameworks">
          <BadgeList
            items={project.data.frameworks}
            urlPrefix="/projekte/framework"
          />
        </IconProperty>
      ) : null
    }

    {
      (project.data.libraries?.length ?? 0) > 0 ? (
        <IconProperty icon="ion:grid-outline" label="Bibliotheken">
          <BadgeList
            items={project.data.libraries}
            urlPrefix="/projekte/library"
          />
        </IconProperty>
      ) : null
    }

    {
      (project.data.styles?.length ?? 0) > 0 ? (
        <IconProperty icon="ion:color-palette-outline" label="Styles">
          <BadgeList items={project.data.styles} urlPrefix="/projekte/styles" />
        </IconProperty>
      ) : null
    }
  </Fragment>
</Card>
