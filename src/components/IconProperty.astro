---
import { Icon } from 'astro-icon/components'

type Props = { icon: string; label?: string }

const { icon, label } = Astro.props
---

<div class="property">
  <span class="icon">
    <Icon name={icon} />
    {label !== undefined ? <span class="label">{label}</span> : null}
  </span>
  <span>
    <slot />
  </span>
</div>

<style>
  .property {
    grid-column-start: 1;
    grid-column-end: -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: first baseline;
    column-gap: var(--spacing-2);
  }

  .icon {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    position: relative;
    top: 2px;
  }

  .label {
    margin-right: var(--spacing-4);
  }
</style>
