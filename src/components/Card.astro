---
import IconProperty from './IconProperty.astro'

export type Property = {
  icon: string
  content: any
}

type Props = {
  title: string
  url: string
}

const { title, url } = Astro.props
---

<article>
  <header>
    <h2><a href={url}>{title}</a></h2>
  </header>

  <div class="properties">
    <slot name="props" />
  </div>
</article>

<style lang="scss">
  @use '../stylesheets/mixins/card.scss' as *;

  article {
    @include card();
    display: grid;
    grid-template-rows: auto 1fr;
    align-items: start;
  }

  header {
    margin-bottom: var(--spacing-4);
  }

  .properties {
    display: grid;
    grid-template-columns: auto 1fr;
    row-gap: var(--spacing-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--theme-page--text-color--muted);
  }

  h2 {
    margin: 0;
    font-size: var(--text-lg);

    a {
      color: var(--palette-neutral-text);
    }
  }
</style>
