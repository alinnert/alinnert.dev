---
export type Property = {
  icon: string
  content: any
}

type Props = {
  title: string
  url: string
}

const { title, url } = Astro.props
---

<article>
  <header>
    <h2><a href={url}>{title}</a></h2>
  </header>

  {
    Astro.slots.has('props') ? (
      <div class="properties">
        <slot name="props" />
      </div>
    ) : null
  }

  {
    Astro.slots.has('details') ? (
      <div class="details">
        <slot name="details" />
      </div>
    ) : null
  }
</article>

<style lang="scss">
  @use '../stylesheets/mixins/card.scss' as *;

  article {
    @include card();
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--spacing-1);
    align-items: start;
  }

  .properties {
    display: grid;
    grid-template-columns: 150px 1fr;
    row-gap: var(--spacing-2);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--theme-page--text-color--muted);
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
  }

  h2 {
    margin: 0;
    font-size: var(--text-lg);

    a {
      color: var(--palette-neutral-text);
    }
  }
</style>
