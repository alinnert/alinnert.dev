---
import IconPropertyList from './IconPropertyList.astro'

export type Property = {
  icon: string
  content: any
}

type Props = {
  title: string
  url?: string
}

const { title, url } = Astro.props
---

<article>
  <header>
    <h2>{url === undefined ? title : <a href={url}>{title}</a>}</h2>
  </header>

  {
    Astro.slots.has('props') ? (
      <div class="properties">
        <IconPropertyList>
          <slot name="props" />
        </IconPropertyList>
      </div>
    ) : null
  }

  {
    Astro.slots.has('details') ? (
      <div class="details">
        <slot name="details" />
      </div>
    ) : null
  }
</article>

<style lang="scss">
  @use '../stylesheets/mixins/card.scss' as *;

  article {
    @include card();
    display: grid;
    grid-auto-rows: auto auto 1fr;
    align-items: start;
  }

  .properties {
    margin-block: var(--spacing-3);
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1_5);
  }

  h2 {
    margin: 0;
    font-size: var(--text-lg);

    a {
      color: var(--palette-neutral-text);
    }
  }
</style>
