---
type Props = { tag: string; color?: string; icon?: string }

const { tag, color, icon } = Astro.props
---

<span>{tag}</span>

<style define:vars={{ 'tag-color': color }}>
  span {
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    padding-inline: var(--spacing-2);
    padding-block: var(--spacing-05);
    background: var(--tag-color, var(--color-sky-700));
    border-radius: var(--radius-md);
  }
</style>
