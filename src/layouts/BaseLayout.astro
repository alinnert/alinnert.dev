---
import PageHeader from '../components/PageHeader.astro'
import '../stylesheets/0-layers/layers.css'
import '../stylesheets/1-system/theme.css'
import '../stylesheets/1-system/tokens.css'
import '../stylesheets/1-system/tools.css'
import '../stylesheets/2-reset/reset.css'
import '../stylesheets/3-base/fonts.css'
import '../stylesheets/3-base/base.css'

type Props = { width?: 'wide' | 'normal' }

const { width = 'normal' } = Astro.props
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>alinnert.dev</title>
  </head>

  <body>
    <div
      class="wrapper"
      class:list={{
        'normal-size': width === 'normal',
        'wide-size': width === 'wide',
      }}
    >
      <PageHeader />
      <slot />
    </div>
  </body>
</html>

<style>
  :root {
    background: var(--theme-page--bg);
    color: var(--theme-page--text-color);
  }

  .wrapper {
    margin-inline: auto;
    max-width: 100vw;
    padding-inline: var(--theme-page--spacing-x);

    &.normal-size {
      width: var(--container-2xl);
    }

    &.wide-size {
      width: var(--container-4xl);
    }
  }
</style>
