---
import BaseLayout from './BaseLayout.astro'

type Props = { title: string }

const { title } = Astro.props
---

<BaseLayout width="wide">
  <div class="grid">
    <h1 class="title">{title}</h1>

    <div class="sidebar">
      <slot name="sidebar" />
    </div>

    <main>
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: var(--spacing-50) 1fr;
    grid-template-rows: auto auto;
    gap: var(--spacing-8);
  }

  .title {
    grid-row: 1;
    grid-column: 2;
  }

  .sidebar {
    grid-row: 2;
    grid-column: 1;
  }

  main {
    grid-row: 2;
    grid-column: 2;
  }
</style>
