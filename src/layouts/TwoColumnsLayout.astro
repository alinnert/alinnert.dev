---
import BaseLayout from './BaseLayout.astro'

type Props = { title: string }

const { title } = Astro.props
---

<BaseLayout width="wide">
  <div class="grid">
    <h1 class="title">{title}</h1>

    <aside class="sidebar">
      <slot name="sidebar" />
    </aside>

    <main>
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: var(--spacing-8);
    grid-template:
      "_          title" auto
      "sidebar    content" auto
      / var(--spacing-50) 1fr;

    @media (width < 800px) {
      grid-template:
        "title" auto
        "sidebar" auto
        "content" auto
        / 1fr;
    }
  }

  .title {
    grid-area: title;
  }

  .sidebar {
    grid-area: sidebar;
  }

  main {
    grid-area: content;
  }
</style>
